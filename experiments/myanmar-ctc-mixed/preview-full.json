  "captions": [
    {
      "id": 1,
      "start": 0.08,
      "end": 4.4,
      "text": "ဒီနေ့ည ပရီးမီယာလိ မှာ အာဆင်နယ် အသင်းဟာ ဟူးစီးတီး ကို အိမ်ကွင်းမှာ လက်ခံယှဉ်ပြိုင်",
      "words": [
        {
          "text": "ဒီနေ့ည",
          "start": 0.12,
          "end": 0.4
        },
        {
          "text": "ပရီးမီယာလိ",
          "start": 0.52,
          "end": 1.04
        },
        {
          "text": "မှာ",
          "start": 1.16,
          "end": 1.2
        },
        {
          "text": "အာဆင်နယ်",
          "start": 1.4000000000000001,
          "end": 1.76
        },
        {
          "text": "အသင်းဟာ",
          "start": 1.84,
          "end": 2.2
        },
        {
          "text": "ဟူးစီးတီး",
          "start": 2.4,
          "end": 2.8000000000000003
        },
        {
          "text": "ကို",
          "start": 2.96,
          "end": 3.0
        },
        {
          "text": "အိမ်ကွင်းမှာ",
          "start": 3.16,
          "end": 3.56
        },
        {
          "text": "လက်ခံယှဉ်ပြိုင်",
          "start": 3.72,
          "end": 4.32
        }
      ]
    },
    {
      "id": 2,
      "start": 4.4,
      "end": 8.6,
      "text": "သွားမှာ ဖြစ်ပါတယ်။ အာဆင်နယ် ဟာ လက်ရှိ ခြေစွမ်းကောင်းမွန်နေပြီး ဒီပွဲမှာလည်း အိမ်ကွင်း",
      "words": [
        {
          "text": "သွားမှာ",
          "start": 4.5200000000000005,
          "end": 4.72
        },
        {
          "text": "ဖြစ်ပါတယ်။",
          "start": 4.84,
          "end": 5.2
        },
        {
          "text": "အာဆင်နယ်",
          "start": 5.68,
          "end": 6.0
        },
        {
          "text": "ဟာ",
          "start": 6.12,
          "end": 6.16
        },
        {
          "text": "လက်ရှိ",
          "start": 6.28,
          "end": 6.48
        },
        {
          "text": "ခြေစွမ်းကောင်းမွန်နေပြီး",
          "start": 6.68,
          "end": 7.5200000000000005
        },
        {
          "text": "ဒီပွဲမှာလည်း",
          "start": 7.68,
          "end": 8.24
        },
        {
          "text": "အိမ်ကွင်း",
          "start": 8.32,
          "end": 8.52
        }
      ]
    },
    {
      "id": 3,
      "start": 8.62,
      "end": 13.46,
      "text": "နိုင်ပွဲကို ဆက်လက်ရယူဖို့ ကြိုးစားလာမှာပါ။ အထူးသဖြင့် ကိုင်ဟာဗက် ရဲ့ တိုက်စစ်အဆုံးသ",
      "words": [
        {
          "text": "နိုင်ပွဲကို",
          "start": 8.68,
          "end": 9.040000000000001
        },
        {
          "text": "ဆက်လက်ရယူဖို့",
          "start": 9.200000000000001,
          "end": 9.88
        },
        {
          "text": "ကြိုးစားလာမှာပါ။",
          "start": 10.040000000000001,
          "end": 10.72
        },
        {
          "text": "အထူးသဖြင့်",
          "start": 11.28,
          "end": 11.76
        },
        {
          "text": "ကိုင်ဟာဗက်",
          "start": 11.96,
          "end": 12.36
        },
        {
          "text": "ရဲ့",
          "start": 12.56,
          "end": 12.64
        },
        {
          "text": "တိုက်စစ်အဆုံးသ",
          "start": 12.8,
          "end": 13.48
        }
      ]
    },
    {
      "id": 4,
      "start": 13.46,
      "end": 18.24,
      "text": "တ်မှုနဲ့ ကွင်းရဲ့ ချိတ်ဆက်ကစားပုံက ဟူး ခံစစ်အတွက် အဓိက စိန်ခေါ်မှု ဖြစ်လာနိုင်ပါတယ်",
      "words": [
        {
          "text": "တ်မှုနဲ့",
          "start": 13.44,
          "end": 13.8
        },
        {
          "text": "ကွင်းရဲ့",
          "start": 14.16,
          "end": 14.4
        },
        {
          "text": "ချိတ်ဆက်ကစားပုံက",
          "start": 14.56,
          "end": 15.36
        },
        {
          "text": "ဟူး",
          "start": 15.68,
          "end": 15.72
        },
        {
          "text": "ခံစစ်အတွက်",
          "start": 15.88,
          "end": 16.4
        },
        {
          "text": "အဓိက",
          "start": 16.56,
          "end": 16.88
        },
        {
          "text": "စိန်ခေါ်မှု",
          "start": 17.080000000000002,
          "end": 17.44
        },
        {
          "text": "ဖြစ်လာနိုင်ပါတယ်",
          "start": 17.6,
          "end": 18.2
        }
      ]
    },
    {
      "id": 5,
      "start": 18.24,
      "end": 22.78,
      "text": "။ တစ်ဖက်မှာ ဟူးစီးတီး ကတော့ ခံစစ်ကို ကျစ်ကျစ်လျစ်လျစ် ပိတ်ဆို့ပြီး အာဆင်နယ် ရဲ့ တို",
      "words": [
        {
          "text": "။",
          "start": 18.24,
          "end": 18.24
        },
        {
          "text": "တစ်ဖက်မှာ",
          "start": 18.8,
          "end": 19.12
        },
        {
          "text": "ဟူးစီးတီး",
          "start": 19.32,
          "end": 19.68
        },
        {
          "text": "ကတော့",
          "start": 19.76,
          "end": 19.96
        },
        {
          "text": "ခံစစ်ကို",
          "start": 20.16,
          "end": 20.56
        },
        {
          "text": "ကျစ်ကျစ်လျစ်လျစ်",
          "start": 20.72,
          "end": 21.2
        },
        {
          "text": "ပိတ်ဆို့ပြီး",
          "start": 21.32,
          "end": 21.68
        },
        {
          "text": "အာဆင်နယ်",
          "start": 22.080000000000002,
          "end": 22.44
        },
        {
          "text": "ရဲ့",
          "start": 22.56,
          "end": 22.6
        },
        {
          "text": "တို",
          "start": 22.72,
          "end": 22.76
        }
      ]
    },
    {
      "id": 6,
      "start": 22.78,
      "end": 26.88,
      "text": "က်စစ်ကို တားဆီးဖို့ ကြိုးစားလာနိုင်ပါတယ်။ ဟူးစီးတီး ရဲ့ တိုက်စစ်မှာတော့ အိုလီဗာမက်ဘန်းနီ",
      "words": [
        {
          "text": "က်စစ်ကို",
          "start": 22.72,
          "end": 23.12
        },
        {
          "text": "တားဆီးဖို့",
          "start": 23.240000000000002,
          "end": 23.64
        },
        {
          "text": "ကြိုးစားလာနိုင်ပါတယ်။",
          "start": 23.76,
          "end": 24.560000000000002
        },
        {
          "text": "ဟူးစီးတီး",
          "start": 25.0,
          "end": 25.400000000000002
        },
        {
          "text": "ရဲ့",
          "start": 25.52,
          "end": 25.560000000000002
        },
        {
          "text": "တိုက်စစ်မှာတော့",
          "start": 25.68,
          "end": 26.240000000000002
        },
        {
          "text": "အိုလီဗာမက်ဘန်းနီ",
          "start": 26.400000000000002,
          "end": 27.28
        }
      ]
    },
    {
      "id": 7,
      "start": 26.88,
      "end": 31.64,
      "text": "ရဲ့ အဆုံးသတ်စွမ်းရည်က အာဆင်နယ် အတွက် သတိထားရမယ့် အချက်တစ်ခု ဖြစ်ပါတယ်။ ဒီပွဲ",
      "words": [
        {
          "text": "ရဲ့",
          "start": 27.36,
          "end": 27.400000000000002
        },
        {
          "text": "အဆုံးသတ်စွမ်းရည်က",
          "start": 27.44,
          "end": 28.32
        },
        {
